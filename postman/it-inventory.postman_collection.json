              "raw": "{\n  \"active\": true,\n  \"name\": \"TESTENT01\",\n  \"serialNumber\": \"ABC123\",\n  \"purchaseValue\": 2500,\n  \"assetModelId\": 1,\n  \"locationId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
