{
  "info": {
    "_postman_id": "116d66b2-45e1-46f6-9f03-79c66d573fc8",
    "name": "IT Inventory API - Etapa 2 Microsserviços",
    "description": "Coleção atualizada para validar a Etapa 2: location-service isolado, integração via OpenFeign, validações e tratamento de 404 remoto. Execute com location-service (8081) e it-inventory (8080) ligados. Para o cenário 503, use a coleção separada de indisponibilidade.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "locationBaseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "assetId",
      "value": "1"
    },
    {
      "key": "locationId",
      "value": "1"
    },
    {
      "key": "missingLocationId",
      "value": "999"
    },
    {
      "key": "createdAssetId",
      "value": ""
    },
    {
      "key": "createdLocationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Location Service - Testes isolados",
      "description": "Execute com o location-service ligado em http://localhost:8081.",
      "item": [
        {
          "name": "01 - Listar localizações",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Resposta é uma lista\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));",
                  "pm.test(\"Localizações iniciais foram carregadas\", () => { const names = pm.response.json().map(x => x.name); pm.expect(names).to.include.members([\"Human Resources\", \"NOC\", \"Comercial\"]); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{locationBaseUrl}}/locations",
              "host": [
                "{{locationBaseUrl}}"
              ],
              "path": [
                "locations"
              ]
            }
          }
        },
        {
          "name": "02 - Buscar localização por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Retorna Human Resources\", () => { const json = pm.response.json(); pm.expect(json.id).to.eql(Number(pm.collectionVariables.get(\"locationId\"))); pm.expect(json.name).to.eql(\"Human Resources\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{locationBaseUrl}}/locations/{{locationId}}",
              "host": [
                "{{locationBaseUrl}}"
              ],
              "path": [
                "locations",
                "{{locationId}}"
              ]
            }
          }
        },
        {
          "name": "03 - Buscar localização inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Erro tratado\", () => { const json = pm.response.json(); pm.expect(json.error).to.eql(\"Not Found\"); pm.expect(json.message).to.include(pm.collectionVariables.get(\"missingLocationId\")); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{locationBaseUrl}}/locations/{{missingLocationId}}",
              "host": [
                "{{locationBaseUrl}}"
              ],
              "path": [
                "locations",
                "{{missingLocationId}}"
              ]
            }
          }
        },
        {
          "name": "04 - Criar localização",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Localização criada\", () => { const json = pm.response.json(); pm.expect(json.id).to.exist; pm.expect(json.name).to.eql(\"Laboratório de Testes\"); pm.collectionVariables.set(\"createdLocationId\", json.id); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{locationBaseUrl}}/locations",
              "host": [
                "{{locationBaseUrl}}"
              ],
              "path": [
                "locations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": true,\n  \"name\": \"Laboratório de Testes\",\n  \"floor\": 2,\n  \"description\": \"Criada pela coleção da Etapa 2\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "02 - IT Inventory - Integração via OpenFeign",
      "description": "Execute após os testes isolados, mantendo os dois serviços ligados. O POST salva automaticamente o ID criado para PUT/DELETE.",
      "item": [
        {
          "name": "01 - Listar todos os ativos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Resposta é uma lista\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));",
                  "pm.test(\"Localizações vieram do serviço remoto\", () => { const json = pm.response.json(); pm.expect(json.length).to.be.at.least(3); const names = json.map(x => x.location); pm.expect(names).to.include.members([\"Human Resources\", \"NOC\", \"Comercial\"]); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
