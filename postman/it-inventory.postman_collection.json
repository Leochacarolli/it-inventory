    {
      "name": "03 - Validações e erros remotos",
      "description": "Execute com os dois serviços ligados. Valida Bean Validation e 404 retornado pelo location-service.",
      "item": [
        {
          "name": "01 - Criar ativo com dados inválidos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Bean Validation retornou os campos inválidos\", () => { const json = pm.response.json(); pm.expect(json.errors).to.be.an(\"object\"); pm.expect(json.errors).to.have.property(\"name\"); pm.expect(json.errors).to.have.property(\"purchaseValue\"); pm.expect(json.errors).to.have.property(\"assetModelId\"); pm.expect(json.errors).to.have.property(\"locationId\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/assets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": true,\n  \"name\": \"\",\n  \"serialNumber\": \"ABC123\",\n  \"purchaseValue\": -100,\n  \"assetModelId\": 0,\n  \"locationId\": -1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "02 - Criar ativo com localização inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"404 remoto foi traduzido pela aplicação principal\", () => { const json = pm.response.json(); pm.expect(json.error).to.eql(\"Not Found\"); pm.expect(json.message).to.include(\"999\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/assets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": true,\n  \"name\": \"TEST-LOCATION-404\",\n  \"serialNumber\": \"LOC999\",\n  \"purchaseValue\": 2500,\n  \"assetModelId\": 1,\n  \"locationId\": 999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
