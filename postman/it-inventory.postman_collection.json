              "mode": "raw",
              "raw": "{\n  \"active\": false,\n  \"name\": \"TESTENT01 - Atualizado\",\n  \"serialNumber\": \"ABC123\",\n  \"purchaseValue\": 2800,\n  \"assetModelId\": 1,\n  \"locationId\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
